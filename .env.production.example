# ====================================================================
# PRODUCTION ortam değişkenleri — Coolify > Application > Environment
# Variables bölümüne bu anahtarları girin (bu dosyayı sunucuya KOYMAYIN).
# ====================================================================

APP_ENV=production
PORT=8080
TEST_MODE_UNLOCK_ALL=false

# --- Veritabanı ---
# Coolify > PostgreSQL resource > "Postgres URL (internal)" değerini kopyalayın.
# Veritabanı adının URL'in sonundaki ile eşleştiğinden emin olun.
DATABASE_URL=postgres://postgres:GUCLU_PAROLA@<coolify-postgres-internal-host>:5432/postgres?sslmode=disable

# --- JWT ---
# Güçlü, rastgele bir değer üretin:  openssl rand -base64 48
JWT_SECRET=BURAYA_UZUN_RASTGELE_DEGER_KOYUN
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Google Sign-In ---
# Mevcut Web Client ID (backend, gelen Google idToken'ının audience'ını buna göre doğrular).
GOOGLE_CLIENT_IDS=928054180858-ru44lr82npuvjdhtf96ap3kobc3bcgn3.apps.googleusercontent.com

# --- Apple Sign-In ---
# iOS uygulamanın bundle id'si (Apple identityToken audience kontrolü). Apple kullanmıyorsan boş bırak.
APPLE_CLIENT_ID=com.senin.bundleid
APPLE_ISSUER=https://appleid.apple.com

# Apple hesap silme (token revoke) — Apple, Sign in with Apple sunan
# uygulamalardan hesap silinirken revoke çağrısı yapılmasını ŞART KOŞAR.
# Üçü birden verilmezse revoke devre dışı kalır (hesap silme yine çalışır).
#   APPLE_TEAM_ID    : Apple Developer hesabındaki 10 karakterlik Team ID
#   APPLE_KEY_ID     : "Sign in with Apple" için ürettiğin anahtarın Key ID'si
#   APPLE_PRIVATE_KEY: o anahtarın .p8 içeriği (satır sonları \n olarak kaçırılabilir)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Firebase (import) ---
# Production'da GEREKMEZ — kelime verisi seed/dictionary_words.sql ile yüklenir.
# Boş bırakılabilir.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# --- Gözlemlenebilirlik ---
# Boşsa hata raporlama devre dışı kalır (uygulama normal çalışır).
SENTRY_DSN=
# Sürüm etiketi; hataları bir derlemeyle eşleştirmek için (ör. 1.0.0+1).
SENTRY_RELEASE=

# --- Güvenlik ---
# Tarayıcı kaynaklı isteklere izin verilen origin'ler (virgülle ayrık).
# Production'da BOŞ bırakılırsa hiçbir origin'e izin verilmez.
# Mobil istemci CORS'tan etkilenmez.
CORS_ALLOWED_ORIGINS=

# Giriş/kayıt uçlarına IP başına hız sınırı (parola deneme saldırılarına karşı).
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=1m

# Genel API hız sınırı (IP başına).
API_RATE_LIMIT=120
API_RATE_LIMIT_WINDOW=1m

# HTTP zaman aşımları ve istek gövdesi üst sınırı.
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
BODY_LIMIT_BYTES=1048576

# --- Yedekleme (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
