# ====================================================================
# PRODUCTION ortam değişkenleri — Coolify > Application > Environment
# Variables bölümüne bu anahtarları girin (bu dosyayı sunucuya KOYMAYIN).
# ====================================================================

APP_ENV=production
PORT=8080
TEST_MODE_UNLOCK_ALL=false

# --- Veritabanı ---
# Coolify > PostgreSQL resource > "Postgres URL (internal)" değerini kopyalayın.
# Veritabanı adının URL'in sonundaki ile eşleştiğinden emin olun.
DATABASE_URL=postgres://postgres:GUCLU_PAROLA@<coolify-postgres-internal-host>:5432/postgres?sslmode=disable

# --- JWT ---
# Güçlü, rastgele bir değer üretin:  openssl rand -base64 48
JWT_SECRET=BURAYA_UZUN_RASTGELE_DEGER_KOYUN
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Google Sign-In ---
# Mevcut Web Client ID (backend, gelen Google idToken'ının audience'ını buna göre doğrular).
GOOGLE_CLIENT_IDS=928054180858-ru44lr82npuvjdhtf96ap3kobc3bcgn3.apps.googleusercontent.com

# --- Apple Sign-In ---
# iOS uygulamanın bundle id'si (Apple identityToken audience kontrolü). Apple kullanmıyorsan boş bırak.
APPLE_CLIENT_ID=com.senin.bundleid
APPLE_ISSUER=https://appleid.apple.com

# --- Firebase (import) ---
# Production'da GEREKMEZ — kelime verisi seed/dictionary_words.sql ile yüklenir.
# Boş bırakılabilir.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
