# Server
PORT=8080
APP_ENV=development
TEST_MODE_UNLOCK_ALL=false

# Database (lokal go run için localhost; docker compose içinde host "db" olur)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/kelimeler?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Google Sign-In (virgülle ayrılmış kabul edilen audience/client ID listesi)
GOOGLE_CLIENT_IDS=928054180858-ru44lr82npuvjdhtf96ap3kobc3bcgn3.apps.googleusercontent.com

# Apple Sign-In (iOS bundle id / Services ID)
APPLE_CLIENT_ID=com.example.kutularlakelimeler
APPLE_ISSUER=https://appleid.apple.com

# Firebase (yalnızca import-dictionary aracı için)
FIREBASE_PROJECT_ID=leitner-kelimeler
FIREBASE_SERVICE_ACCOUNT=./secrets/service-account.json
