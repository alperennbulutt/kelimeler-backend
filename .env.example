# Server
PORT=8080
# "production" dışında parola ile kayıt/giriş uçları (/auth/register,
# /auth/login) açıktır; lokal E2E koşuları bunları kullanır.
APP_ENV=development
TEST_MODE_UNLOCK_ALL=false

# Günlük kullanım sayaçlarının (ücretsiz grup, reklam geçişleri, tekrar cevabı
# sayısı) gün sınırı: sayaçlar bu saat diliminin gece yarısında sıfırlanır.
# IANA adı; çözülemezse Europe/Istanbul kullanılır.
USAGE_TIMEZONE=Europe/Istanbul

# Database (lokal go run için localhost; docker compose içinde host "db" olur)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/kelimeler?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Google Sign-In (virgülle ayrılmış kabul edilen audience/client ID listesi)
GOOGLE_CLIENT_IDS=928054180858-ru44lr82npuvjdhtf96ap3kobc3bcgn3.apps.googleusercontent.com

# Apple Sign-In (iOS bundle id / Services ID)
APPLE_CLIENT_ID=com.example.kutularlakelimeler
APPLE_ISSUER=https://appleid.apple.com

# Apple hesap silme (token revoke) — Apple, Sign in with Apple sunan
# uygulamalardan hesap silinirken revoke çağrısı yapılmasını ŞART KOŞAR.
# Üçü birden verilmezse revoke devre dışı kalır (hesap silme yine çalışır).
#   APPLE_TEAM_ID    : Apple Developer hesabındaki 10 karakterlik Team ID
#   APPLE_KEY_ID     : "Sign in with Apple" için ürettiğin anahtarın Key ID'si
#   APPLE_PRIVATE_KEY: o anahtarın .p8 içeriği (satır sonları \n olarak kaçırılabilir)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Firebase (yalnızca import-dictionary aracı için)
FIREBASE_PROJECT_ID=leitner-kelimeler
FIREBASE_SERVICE_ACCOUNT=./secrets/service-account.json

# --- Gözlemlenebilirlik ---
# Boşsa hata raporlama devre dışı kalır (uygulama normal çalışır).
SENTRY_DSN=
# Sürüm etiketi; hataları bir derlemeyle eşleştirmek için (ör. 1.0.0+1).
SENTRY_RELEASE=

# --- Güvenlik ---
# Tarayıcı kaynaklı isteklere izin verilen origin'ler (virgülle ayrık).
# Production'da BOŞ bırakılırsa hiçbir origin'e izin verilmez: yanıtlara CORS
# başlığı yazılmaz. Geliştirmede boşken tüm origin'lere izin verilir.
# Mobil istemci CORS'tan etkilenmez.
CORS_ALLOWED_ORIGINS=

# Kimlik üreten uçlara (Google/Apple girişi; production dışında parola ile
# kayıt/giriş) IP başına sıkı hız sınırı, deneme saldırılarına karşı.
# /auth/refresh buna değil genel API sınırına tabidir.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW=1m

# Genel API hız sınırı (IP başına). Mobil operatörler çok sayıda kullanıcıyı
# tek IP arkasına koyar (CGNAT) ve bir tekrar seansı dakikada onlarca istek
# üretir; düşük bir değer gerçek kullanıcıları 429'a düşürür.
# İki sınırda da 0 ya da negatif değer sınırı KAPATMAZ: varsayılana dönülür.
API_RATE_LIMIT=600
API_RATE_LIMIT_WINDOW=1m

# HTTP zaman aşımları ve istek gövdesi üst sınırı.
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
BODY_LIMIT_BYTES=1048576

# --- Yedekleme (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
